rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function em() {
      return request.auth != null && request.auth.token.email != null ? request.auth.token.email : '';
    }
    function isSuper() { return em() == 'superadmin@pegawai.app'; }
    function grp() {
      return em() == 'pns@pegawai.app' ? 'PNS' : (em() == 'pppk@pegawai.app' ? 'PPPK' : '');
    }
    function canSheet(sh) { return isSuper() || grp() == sh; }

    // Aturan satu catatan koreksi: hanya 7 isian, hanya pada sheet milik akunnya
    function validEdit(id) {
      let x = request.resource.data;
      return canSheet(x.sh)
        && id.matches('^[a-z0-9]+_' + x.sh + '_[0-9]+$')
        && x.keys().hasOnly(['sh','s','k','t','by','acc','at'])
        && x.keys().hasAll(['sh','s','k','t','by','acc','at'])
        && x.s in ['Sesuai', 'Tidak Sesuai']
        && x.k is string && x.k.size() <= 500
        && x.t is string && x.t.matches('^[+]?[0-9][0-9 -]{7,14}$')
        && x.by is string && x.by.size() >= 3 && x.by.size() <= 100
        && (grp() == '' || x.by.matches('^[0-9]{18} .+$'))
        && x.acc == (isSuper() ? 'superadmin' : grp())
        && x.at is number
        && (resource == null || resource.data.sh == x.sh);
    }

    // Pengaturan data (versi, nama kolom, kamus kode)
    match /meta/{d} {
      allow read: if isSuper() || grp() != '';
      allow write: if isSuper();
    }

    // Data pegawai dan keluarga (hanya superadmin yang boleh mengisi/mengubah)
    match /base/{d} {
      allow read: if canSheet(resource.data.sh);
      allow write: if isSuper();
    }

    // Koreksi dari pegawai
    match /edits/{d} {
      allow read: if canSheet(resource.data.sh);
      allow create, update: if validEdit(d);
      allow delete: if isSuper();
    }

    // Semua yang lain ditolak secara bawaan
  }
}
